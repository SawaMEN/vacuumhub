{$DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 105MB
    }
    reverse_proxy app:8080
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
    }
    log {
        output stdout
        format json
    }
}
