[Unit]
Description=VacuumHub — robot vacuum firmware and voice catalog
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=vacuumhub
Group=vacuumhub
WorkingDirectory=/opt/vacuumhub
EnvironmentFile=/etc/vacuumhub/environment
ExecStartPre=/opt/vacuumhub/vacuumhub --check-config
ExecStart=/opt/vacuumhub/vacuumhub
Restart=on-failure
RestartSec=5
StateDirectory=vacuumhub
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/vacuumhub
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
