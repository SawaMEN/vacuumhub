# Replace with your own domain name. DNS A/AAAA records must point to the VPS.
DOMAIN=vacuum.example.com
# Mandatory random secret, at least 24 characters. Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=REPLACE_WITH_A_RANDOM_64_CHARACTER_TOKEN

# Firmware approval requires a reachable ClamAV daemon (e.g. clamav:3310 on Docker network).
# Without this setting, firmware publication is blocked.
FIRMWARE_CLAMD_ADDR=
# Optional: comma-separated pinned Ed25519 public keys: key-id:hex-encoded-32-byte-key
FIRMWARE_TRUSTED_KEYS=
